# Required for the browser build. Vite exposes VITE_ variables to the client,
# so only use the Supabase *publishable* key here — never the service_role key.
# Get these from Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: public site URL used for canonical links and the sitemap.
# Set this when the custom domain is live (e.g. https://annasbeautistry.com).
# SITE_URL=https://annasbeautistry.com
